datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Decision Audit Table (Used for inactivity audits and kill switch checks)
model DecisionAudit {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classification  String   @db.VarChar(50)
  rejectionReason String?  @map("rejection_reason")
  systemRiskState String   @map("system_risk_state") @db.VarChar(50)
  htf             Json?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([classification])
  @@index([createdAt(sort: Desc)])
  @@map("decision_audit")
}

enum IncidentTransitionType {
  DETECTED
  LEVEL_CHANGED
  RESOLVED
}

enum IncidentActor {
  WATCHDOG
  SYSTEM
  USER
  SIMULATOR
  RECOVERY
}

enum IncidentSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  WARNING
  CRITICAL
}

enum IncidentGroupType {
  INFRASTRUCTURE
  OPERATIONS
}

// 2. Incidents Table (Tracks Global and Symbol level incidents)
model Incident {
  id          Int                  @id @default(autoincrement())
  symbol      String?              @db.VarChar(20)
  level       IncidentSeverity
  source      String               @db.VarChar(100)
  reason      String
  detectedAt  BigInt               @map("detected_at")
  resolvedAt  BigInt?              @map("resolved_at")
  transitions IncidentTransition[]

  groupId     Int?                 @map("group_id")
  group       IncidentGroup?       @relation(fields: [groupId], references: [id])

  @@index([symbol])
  @@index([level])
  @@index([groupId])
  @@map("incidents")
}

model IncidentGroup {
  id              Int               @id @default(autoincrement())
  correlationKey  String            @map("correlation_key") @db.VarChar(100)
  symbol          String?           @db.VarChar(20)
  groupType       IncidentGroupType @map("group_type")
  openedAt        BigInt            @map("opened_at")
  resolvedAt      BigInt?           @map("resolved_at")
  highestSeverity IncidentSeverity  @map("highest_severity")
  incidents       Incident[]

  @@index([correlationKey, resolvedAt])
  @@map("incident_groups")
}

model IncidentTransition {
  id             Int                    @id @default(autoincrement())
  incidentId     Int                    @map("incident_id")
  incident       Incident               @relation(fields: [incidentId], references: [id])
  transitionType IncidentTransitionType @map("transition_type")
  level          IncidentSeverity?
  reason         String
  actor          IncidentActor
  occurredAt     BigInt                 @map("occurred_at")

  @@index([incidentId, occurredAt])
  @@map("incident_transitions")
}

// 3. Alert Log Table (Deduplicated System Warnings)
model AlertLog {
  id        Int      @id @default(autoincrement())
  level     String   @db.VarChar(50)
  title     String
  message   String
  entityId  String?  @map("entity_id") @db.VarChar(100)
  timestamp DateTime @default(now())

  @@map("alert_log")
}

// 4. Circuit Breaker State Table (Protections like drawdowns)
model CircuitBreakerState {
  id          Int      @id @default(autoincrement())
  breakerType String   @unique @map("breaker_type") @db.VarChar(50)
  status      String   @db.VarChar(50)
  currentVal  Decimal  @map("current_val") @db.Decimal(10, 4)
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  @@map("circuit_breaker_state")
}

// 5. Monitored Bot Table (Multi-client support structure)
model MonitoredBot {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  strategyName String   @map("strategy_name") @db.VarChar(100)
  broker       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("monitored_bot")
}

// 6. User Table (External table to preserve during migrations)
model User {
  id                  String    @id
  nin                 String?
  phoneNumber         String?
  password            String?
  nom                 String?
  prenom              String?
  date_de_naissance   String?
  profileImageUrl     String?
  identityDocumentUrl String?
  selfieImageUrl      String?
  app_role            String?
  isVerified          Boolean?
  otp                 String?
  otpExpiresAt        DateTime?
  createdAt           DateTime?
  updatedAt           DateTime?
  tempPhoneNumber     String?

  @@map("User")
}
